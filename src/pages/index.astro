---
import Base from '../layouts/Base.astro';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';

interface SummarySet {
  small: string;
  medium: string;
  large: string;
}

interface StorySummary {
  id: number;
  title: string;
  url: string;
  hnUrl: string;
  author: string;
  score: number;
  commentCount: number;
  submittedAt?: string;
  summary: SummarySet | string;
}

interface StoriesData {
  date: string;
  generatedAt: string;
  stories: StorySummary[];
}

// Read the latest stories data at build time
const dataPath = join(process.cwd(), 'data', 'latest.json');
let data: StoriesData | null = null;

if (existsSync(dataPath)) {
  data = JSON.parse(readFileSync(dataPath, 'utf-8'));
}

function extractDomain(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
}

function formatTime(isoStr: string): string {
  const d = new Date(isoStr);
  const hours = d.getHours().toString().padStart(2, '0');
  const minutes = d.getMinutes().toString().padStart(2, '0');
  return `${d.toLocaleDateString('en-GB', { month: 'short', day: 'numeric' })} at ${hours}:${minutes}`;
}

function renderSummary(text: string): string {
  return text.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    '<a href="$2" rel="noopener">$1</a>'
  );
}

function renderLargeSummary(text: string): string {
  let html = renderSummary(text);

  // Convert **bold** to <strong>
  html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

  // Split into paragraphs on double newlines
  const paragraphs = html.split(/\n\n+/);
  const rendered = paragraphs.map(para => {
    const lines = para.split('\n');
    // Check if this paragraph is a bullet list
    if (lines.every(l => l.trimStart().startsWith('- ') || l.trim() === '')) {
      const items = lines
        .filter(l => l.trimStart().startsWith('- '))
        .map(l => `<li>${l.replace(/^\s*- /, '')}</li>`)
        .join('');
      return `<ul>${items}</ul>`;
    }
    return `<p>${para.replace(/\n/g, ' ')}</p>`;
  }).join('');

  return rendered;
}

function normaliseSummary(summary: SummarySet | string): SummarySet {
  if (typeof summary === 'string') {
    return { small: summary, medium: summary, large: summary };
  }
  return summary;
}

function formatDate(dateStr: string): string {
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-US', {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Base title="HN Summaries">
  <div class="page">
    {data ? (
      <>
        <header class="masthead">
          <h1 class="masthead__title">The <em>Hacker</em> Briefing</h1>
          <div class="masthead__date">{formatDate(data.date)}</div>
          <div class="masthead__edition">Top stories from Hacker News, summarised</div>
          <div class="size-toggle size-toggle--global" data-scope="global">
            <button class="size-toggle__btn" data-size="small">S</button>
            <button class="size-toggle__btn active" data-size="medium">M</button>
            <button class="size-toggle__btn" data-size="large">L</button>
          </div>
        </header>

        <main>
          {data.stories.map((story, i) => {
            const domain = extractDomain(story.url);
            const isHNPost = story.url.includes('news.ycombinator.com');
            const sum = normaliseSummary(story.summary);
            return (
              <article class="story" data-story-id={story.id}>
                <div class="story__rank">{i + 1}</div>
                <div class="story__content">
                  <h2 class="story__title">
                    <a href={story.url} rel="noopener">
                      {story.title}
                    </a>
                    {!isHNPost && domain && (
                      <a href={story.url} rel="noopener" class="story__domain">({domain})</a>
                    )}
                    <span class="size-toggle size-toggle--inline" data-scope="story">
                      <button class="size-toggle__btn" data-size="small">S</button>
                      <button class="size-toggle__btn" data-size="medium">M</button>
                      <button class="size-toggle__btn" data-size="large">L</button>
                    </span>
                  </h2>
                  <div class="story__summaries">
                    <p class="story__summary" data-size="small" set:html={renderSummary(sum.small)} />
                    <p class="story__summary" data-size="medium" set:html={renderSummary(sum.medium)} />
                    <div class="story__summary" data-size="large" set:html={renderLargeSummary(sum.large)}></div>
                  </div>
                  <div class="story__meta">
                    <a href={story.hnUrl} rel="noopener" class="story__meta-link">
                      Submitted {story.submittedAt ? formatTime(story.submittedAt) : ''} by {story.author}
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </main>

        <footer class="footer">
          Summaries generated with Gemini 3 Flash via OpenRouter.
          Data from the <a href="https://news.ycombinator.com" rel="noopener">Hacker News API</a>.
        </footer>
      </>
    ) : (
      <div class="empty">
        <h1 class="empty__title">No stories yet</h1>
        <p class="empty__text">Run the fetch script to generate today's summaries:</p>
        <code class="empty__code">pnpm fetch</code>
      </div>
    )}
  </div>
</Base>

<script>
  const DEFAULT_SIZE = 'medium';
  const SIZES = ['small', 'medium', 'large'];

  function currentSize(article: Element): string {
    const visible = article.querySelector('.story__summary.visible') as HTMLElement | null;
    return visible?.dataset.size ?? DEFAULT_SIZE;
  }

  function nextSize(size: string): string {
    return SIZES[(SIZES.indexOf(size) + 1) % SIZES.length];
  }

  function setStorySize(article: Element, size: string) {
    article.querySelectorAll('.story__summary').forEach((el) => {
      const h = el as HTMLElement;
      if (h.dataset.size === size) {
        h.classList.add('visible');
        h.classList.remove('hidden');
      } else {
        h.classList.remove('visible');
        h.classList.add('hidden');
      }
    });
    const toggle = article.querySelector('.size-toggle--inline');
    if (toggle) {
      toggle.querySelectorAll('.size-toggle__btn').forEach((btn) => {
        btn.classList.toggle('active', (btn as HTMLElement).dataset.size === size);
      });
    }
  }

  function setGlobalSize(size: string) {
    document.querySelectorAll('.story').forEach((article) => {
      article.removeAttribute('data-local-size');
      setStorySize(article, size);
    });
    document.querySelectorAll('.size-toggle--global .size-toggle__btn').forEach((btn) => {
      btn.classList.toggle('active', (btn as HTMLElement).dataset.size === size);
    });
  }

  // Initialise: show medium, hide others
  setGlobalSize(DEFAULT_SIZE);

  // Global toggle
  document.querySelector('.size-toggle--global')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.size-toggle__btn') as HTMLElement | null;
    if (!btn) return;
    setGlobalSize(btn.dataset.size!);
  });

  // Per-story toggle
  document.querySelectorAll('.size-toggle--inline').forEach((toggle) => {
    toggle.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const btn = (e.target as HTMLElement).closest('.size-toggle__btn') as HTMLElement | null;
      if (!btn) return;
      const article = btn.closest('.story')!;
      setStorySize(article, btn.dataset.size!);
    });
  });

  // Click summary text to cycle size
  document.querySelectorAll('.story__summaries').forEach((wrapper) => {
    wrapper.addEventListener('click', () => {
      const article = wrapper.closest('.story')!;
      setStorySize(article, nextSize(currentSize(article)));
    });
  });
</script>
